# Azure sets PORT itself at runtime - leave unset in App Settings.
NODE_ENV=production

# The app's own Azure Web App URL (client and API are served from the same origin in production).
CLIENT_URL=https://<your-app-name>.azurewebsites.net

# Register an app at https://aps.autodesk.com with callback URL matching APS_CALLBACK_URL below.
# Required scopes requested at login: data:read data:write data:create data:search account:read
APS_CLIENT_ID=your-client-id
APS_CLIENT_SECRET=your-client-secret
APS_CALLBACK_URL=https://<your-app-name>.azurewebsites.net/api/auth/callback

# Any random long string, used to sign the session cookie - required, no default.
SESSION_SECRET=change-me-to-a-random-string
